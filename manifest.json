{
  "manifest_version": 3,
  "name": "GoGuardian Web Activity Notice",
  "version": "1.2.5",
  "description": "Displays a notice that school web activity may be monitored and filtered by GoGuardian.",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "banner.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "update_url": "https://pcktdrp.github.io/ggbanner/update.xml"
}